# Local dev defaults to sqlite - no setup needed, just run the server.
# For Postgres locally: DATABASE_URL=postgresql://user:password@localhost:5432/gym_progress
DATABASE_URL=sqlite:///./gym.db

# Change this in production - Render's render.yaml auto-generates one for you.
SECRET_KEY=insert-your-secure-secret-here

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=https://your-app.netlify.app,http://localhost:5500
CORS_ORIGINS=*

# AI Coach Config (Gemini API)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
# Defaults to gemini-2.5-flash if not set
GEMINI_MODEL=gemini-2.5-flash

# Enable to return password reset links in the JSON response instead of emailing them.
# ONLY USE THIS FOR DEMOS/PORTFOLIOS - DANGEROUS IN PRODUCTION!
DEMO_MODE=false
