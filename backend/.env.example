# Local dev defaults to sqlite - no setup needed, just run the server.
# For Postgres locally: DATABASE_URL=postgresql://user:password@localhost:5432/gym_progress
DATABASE_URL=sqlite:///./gym.db

# Change this in production
SECRET_KEY=insert-your-secure-secret-here

ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=https://your-app.netlify.app,http://localhost:5500
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# AI Coach Config (Gemini API)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=
# Defaults to gemini-3.6-flash if not set
GEMINI_MODEL=gemini-3.6-flash

# Enable to return password reset links in the JSON response instead of emailing them.
# ONLY USE THIS FOR DEMOS/PORTFOLIOS - DANGEROUS IN PRODUCTION!
DEMO_MODE=false

# Database Configuration (PostgreSQL for Prod, SQLite for Dev)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here

# Brevo (formerly Sendinblue) Email Service
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email@example.com

# Frontend Configuration
FRONTEND_URL=http://localhost:8080

# Error Tracking
SENTRY_DSN=your_sentry_dsn_here


# Push Notifications (Web Push)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Admin User Setup
INITIAL_ADMIN_USERNAME=admin
